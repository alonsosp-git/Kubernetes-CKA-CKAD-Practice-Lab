# Lab 27 - certificates, CSRs and kubeconfig   (CKA, handbook page 36)
# Goal: add a user from nothing, give them exactly one namespace, prove it works.

kubectl create namespace dev
kubectl create deployment api --image=nginx:1.25 -n dev
sim tick 6

# --- 1. the user asks for a certificate ---
kubectl create csr alice --user=alice --group=developers
kubectl get csr
kubectl describe csr alice

# --- 2. an admin approves it ---
kubectl certificate approve alice
kubectl get csr

# --- 3. put it in a kubeconfig ---
kubectl config set-cluster lab-cluster --server=https://127.0.0.1:6443
kubectl config set-credentials alice --client-certificate=alice.crt --client-key=alice.key
kubectl config set-context alice-ctx --cluster=lab-cluster --user=alice --namespace=dev
kubectl config get-contexts

# --- 4. a certificate alone grants nothing ---
sim rbac on
kubectl config use-context alice-ctx
#!expect-error
kubectl get pods

# --- 5. bind a Role and try again ---
kubectl config use-context lab
kubectl create role pod-reader --verb=get,list,watch --resource=pods -n dev
kubectl create rolebinding alice-read --role=pod-reader --user=alice -n dev
kubectl config use-context alice-ctx
kubectl get pods
kubectl auth can-i delete pods
kubectl config use-context lab
sim rbac off

# --- 6. control-plane certificates expire ---
kubeadm certs check-expiration
sim age-certs 340
kubeadm certs check-expiration
kubeadm certs renew all
kubeadm certs check-expiration
